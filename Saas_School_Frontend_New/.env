# ==============================================================================
# School SaaS Frontend — Local Development Environment
# ==============================================================================
# All 9 local Spring Boot microservices are proxied via vite.config.js on
# http://localhost:5173 so every browser request stays same-origin (no CORS issues).
#
# Local Microservice Port Mapping (vite.config.js):
#   /service1 -> http://localhost:8085  (Admission & School)
#   /service2 -> http://localhost:8089  (Teacher, EDP, Librarian, Accountant, Assignments)
#   /service3 -> http://localhost:8090  (Settings: BloodGroup, Gender, Religion)
#   /service4 -> http://localhost:8092  (Auth-Service: Login, Logout, Password Reset)
#   /service5 -> http://localhost:8081  (AcademicMain: Classes, Sections, Subjects, Rooms, Services)
#   /service6 -> http://localhost:8094  (Result: Grades, Criteria, Marks Register, Marksheet)
#   /service7 -> http://localhost:8084  (RoutineMain: Routines, Class Times, Exam Types, Events)
#   /service8 -> http://localhost:8082  (NewLibrary: Categories, Books, Issue, Return)
#   /service9 -> http://localhost:8099  (SchoolAccount: Fees, Tuition, Income, Expense, Bank)
# ==============================================================================

# App Metadata
VITE_REACT_VERSION="D:0.1"

# Payment Gateway (Razorpay Test Key for Local Development)
VITE_REACT_razorpay_key="rzp_test_nRkrV0ODyqs6co"

# Base URL (Empty string so requests use same-origin Vite dev proxy)
VITE_REACT_BASE_URL=""

# Local Microservice Proxy Routes
VITE_REACT_SERVICE1_URL="/service1"
VITE_REACT_SERVICE2_URL="/service2"
VITE_REACT_SERVICE3_URL="/service3"
VITE_REACT_SERVICE4_URL="/service4"
VITE_REACT_SERVICE5_URL="/service5"
VITE_REACT_SERVICE6_URL="/service6"
VITE_REACT_SERVICE7_URL="/service7"
VITE_REACT_SERVICE8_URL="/service8"
VITE_REACT_SERVICE9_URL="/service9"


VITE_ENABLE_PROXY=true
# ==============================================================================
# OPTIONAL / EXTERNAL SCHOOLFEED SERVICE (Not running locally — commented out)
# Uncomment if you run the separate Node.js schoolfeed server locally.
# ==============================================================================
